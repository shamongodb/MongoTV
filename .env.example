# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=mongotv
# For X509 cert auth (optional): path to your client .pem file
# MONGODB_TLS_CERT_KEY_FILE=/path/to/client.pem

# Auth
JWT_SECRET=your-secret-key-change-in-production

# VoyageAI (required for embeddings and AI Guide chat)
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-3

# LLM for AI Guide: Azure OpenAI (default) or Grok (xAI). Omit or set to azure to use Azure.
# RAG_LLM_PROVIDER=azure
# RAG_LLM_PROVIDER=grok

# Azure OpenAI (required when RAG_LLM_PROVIDER is azure or unset)
AZURE_API_KEY=your-azure-openai-api-key
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# Grok / xAI (required when RAG_LLM_PROVIDER=grok; OpenAI-compatible API)
# XAI_API_KEY=your-xai-api-key
# GROK_API_KEY=your-xai-api-key
# GROK_MODEL=grok-3
# XAI_MODEL=grok-3
# XAI_BASE_URL=https://api.x.ai/v1

# Chat memory tuning (optional)
CHAT_SESSION_TTL_HOURS=24
CHAT_MESSAGE_TTL_DAYS=30
CHAT_RECENT_TURN_LIMIT=8
CHAT_SUMMARY_SOURCE_LIMIT=24
USER_MEMORY_LIMIT=5
USER_MEMORY_VECTOR_INDEX=user_memory_vector_index

PORT=3000
