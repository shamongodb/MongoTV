<div class="mongo-chat-launcher-wrap">
  <button
    id="mongo-voice-launcher"
    class="mongo-chat-launcher mongo-voice-launcher"
    type="button"
    aria-label="Start voice recommendations (Cmd+Shift+2)"
    title="Start voice recommendations (Cmd+Shift+2)"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 14.5a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5.5a3 3 0 0 0 3 3zm5-3a1 1 0 1 1 2 0 7 7 0 0 1-6 6.93V21h3a1 1 0 1 1 0 2H8a1 1 0 1 1 0-2h3v-2.57A7 7 0 0 1 5 11.5a1 1 0 0 1 2 0 5 5 0 0 0 10 0z"></path>
    </svg>
  </button>
  <button id="mongo-chat-launcher" class="mongo-chat-launcher" type="button" aria-label="Open AI Guide chat">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M18.5 3.5c-4.9.1-9.4 2.1-12.2 5.3-2.7 3.2-3.3 7.6-1.2 11.7.2.4.6.6 1 .6 1.1 0 2.2-.2 3.1-.6 4.9-1.8 8.9-6.1 10.5-11.3.4-1.3.7-2.7.8-4 0-.5-.4-.9-.9-.9h-1.1zM8.5 17.4c-.4.2-.9.3-1.3.4-.7-2.2-.3-4.6 1.2-6.4 1.8-2.1 4.5-3.5 7.6-4-1.2 4.3-4.3 7.9-7.5 10z"></path>
    </svg>
  </button>
</div>

<section id="mongo-voice-dialog" class="mongo-voice-dialog" aria-hidden="true">
  <div class="mongo-voice-hero" aria-hidden="true">
    <div class="mongo-voice-ring">
      <div class="mongo-voice-mic-core">
        <svg viewBox="0 0 24 24">
          <path d="M12 14.5a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5.5a3 3 0 0 0 3 3zm5-3a1 1 0 1 1 2 0 7 7 0 0 1-6 6.93V21h3a1 1 0 1 1 0 2H8a1 1 0 1 1 0-2h3v-2.57A7 7 0 0 1 5 11.5a1 1 0 0 1 2 0 5 5 0 0 0 10 0z"></path>
        </svg>
      </div>
    </div>
  </div>
  <p id="mongo-voice-label" class="mongo-voice-label">Listening...</p>
  <canvas id="mongo-voice-meter" class="mongo-voice-meter" width="260" height="72" aria-label="Audio activity meter"></canvas>
  <p id="mongo-voice-error" class="mongo-voice-error" role="status" aria-live="polite"></p>
  <button id="mongo-voice-stop" class="mongo-voice-stop" type="button">Stop</button>
</section>

<section id="mongo-chat-panel" class="mongo-chat-panel" aria-hidden="true">
  <header class="mongo-chat-header">
    <strong>Mongo Leaf Guide</strong>
    <button id="mongo-chat-close" class="mongo-chat-icon-btn" type="button" aria-label="Close chat">x</button>
  </header>
  <div id="mongo-chat-messages" class="mongo-chat-messages"></div>
  <div class="mongo-chat-toolbar">
    <button id="mongo-chat-new-session" type="button" class="mongo-chat-new-session">New Session</button>
  </div>
  <form id="mongo-chat-form" class="mongo-chat-form">
    <input type="text" id="mongo-chat-input" name="message" placeholder="Ask for something to watch..." autocomplete="off">
    <button type="submit">Send</button>
  </form>
</section>

<style>
