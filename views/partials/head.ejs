<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title + ' — MongoTV' : 'MongoTV' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-dark: #000000;
    --bg-card: #0a0a0a;
    --bg-hover: #141414;
    --orange: #47A248;
    --orange-dim: #3d8b40;
    --text: #ffffff;
    --text-muted: rgba(255,255,255,0.7);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'Outfit', sans-serif;
    background: var(--bg-dark);
    color: var(--text);
    min-height: 100vh;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .app {
    display: flex;
    min-height: 100vh;
  }
  .sidebar {
    width: 96px;
    background: var(--bg-card);
    border-right: 1px solid rgba(255,255,255,0.06);
    padding: 1.25rem 0.5rem;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
  }
  .sidebar .sidebar-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
  }
  .sidebar .sidebar-nav a {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s, background 0.15s, border-color 0.15s, transform 0.15s;
  }
  .sidebar .sidebar-nav a svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }
  .sidebar .sidebar-nav a:hover {
    transform: translateY(-1px);
  }
  .sidebar .sidebar-nav a:hover, .sidebar .sidebar-nav a.active {
    color: var(--orange);
    background: rgba(71,162,72,0.15);
    border-color: rgba(71,162,72,0.4);
  }
  .sidebar .sidebar-nav a:focus-visible {
    outline: 2px solid rgba(71,162,72,0.65);
    outline-offset: 3px;
  }
  .top-nav {
    height: 56px;
    background: var(--bg-card);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    flex-shrink: 0;
  }
  .top-nav .logo { font-weight: 700; font-size: 1.25rem; color: var(--orange); }
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .main-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }
</style>
