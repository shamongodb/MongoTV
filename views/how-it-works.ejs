    </aside>

    <div class="main">
      <header class="top-nav">
        <span class="logo">MongoTV</span>
      </header>

      <main class="main-content workflow-page">
        <div class="workflow-shell">
          <aside class="workflow-progress" aria-label="Workflow progress">
            <p class="progress-title">Workflow Stages</p>
            <ol>
              <li><a href="#stageA" data-stage-link="stageA" aria-current="true">Stage A: Intent Rewrite</a></li>
              <li><a href="#stageB" data-stage-link="stageB">Stage B: Query Embeddings</a></li>
              <li><a href="#stageC" data-stage-link="stageC">Stage C: Vector + Lexical Retrieval</a></li>
              <li><a href="#stageD" data-stage-link="stageD">Stage D: Grounded Synthesis</a></li>
              <li><a href="#stageE" data-stage-link="stageE">Stage E: Memory + Platform</a></li>
            </ol>
            <button class="detail-btn secondary" type="button" data-open-detail>
              See detailed view
            </button>
          </aside>

          <div class="workflow-content">
            <section class="hero-workflow">
              <div class="paper-strip">Smart Brain Workflow</div>
              <figure class="hero-reference-image">
                <img src="/images/hybrid-ai-search-engine-architecture.png" alt="Hybrid AI Search Engine architecture reference diagram" loading="eager" />
              </figure>
              <h1>The Smart Brain: How MongoTV Delivers Contextual Magic</h1>
              <p>
                Scroll this page to see how one user request travels through intent planning, embeddings, vector and lexical retrieval,
                grounded response synthesis, and memory-aware personalization.
              </p>
              <div class="hero-actions">
                <button class="detail-btn primary" type="button" data-open-detail>
                  See detailed view
                </button>
                <span class="hero-note">The full detailed content appears only in the drawer.</span>
              </div>
            </section>

            <section id="stageA" class="workflow-stage" data-stage="stageA">
              <div class="stage-tag">Stage A</div>
              <h2>User query and intent rewrite</h2>
              <p class="what-happens">
                The user asks in natural language. LangGraph planning classifies whether the turn needs search, clarification, or a direct response.
              </p>
              <div class="stage-grid">
                <article>
                  <h3>What happens</h3>
                  <p>The planner rewrites ambiguous requests into retrieval-ready query text.</p>
                </article>
                <article>
                  <h3>Systems involved</h3>
                  <div class="badges"><span>LangChain</span><span>LangGraph</span><span>Zod</span></div>
                </article>
                <article>
                  <h3>Why it matters</h3>
                  <p>Follow-ups like “more action, same vibe” become precise search intent.</p>
                </article>
              </div>
            </section>

            <section id="stageB" class="workflow-stage" data-stage="stageB">
              <div class="stage-tag">Stage B</div>
              <h2>Embedding the request context</h2>
              <p class="what-happens">
                VoyageAI generates a high-quality query embedding that matches the dimension expected by the MongoDB Atlas vector index.
              </p>
              <div class="stage-grid">
                <article>
                  <h3>What happens</h3>
                  <p>Request text is embedded with <code>inputType: query</code> and dimension-checked before retrieval.</p>
                </article>
                <article>
                  <h3>Systems involved</h3>
                  <div class="badges"><span>VoyageAI</span><span>MongoDB</span><span>Node.js</span></div>
                </article>
                <article>
                  <h3>Why it matters</h3>
                  <p>Embedding alignment keeps semantic search accurate and avoids vector mismatch failures.</p>
                </article>
              </div>
            </section>

            <section id="stageC" class="workflow-stage" data-stage="stageC">
              <div class="stage-tag">Stage C</div>
              <h2>Vector and lexical retrieval in MongoDB</h2>
              <p class="what-happens">
                MongoDB runs vector retrieval for semantic similarity and Atlas Search for lexical/title/people matches, then fuses rank signals.
              </p>
              <div class="stage-grid">
                <article>
                  <h3>What happens</h3>
                  <p>Parallel retrieval paths execute and return candidate catalog matches with scores.</p>
                </article>
                <article>
                  <h3>Systems involved</h3>
                  <div class="badges"><span>MongoDB Atlas</span><span>Atlas Search</span><span>$vectorSearch</span></div>
                </article>
                <article>
                  <h3>Why it matters</h3>
                  <p>Hybrid retrieval captures both semantic meaning and exact title/person intent.</p>
                </article>
              </div>
            </section>

            <section id="stageD" class="workflow-stage" data-stage="stageD">
              <div class="stage-tag">Stage D</div>
              <h2>Grounded response synthesis</h2>
              <p class="what-happens">
                The response is composed from retrieved catalog results only, with parallel fan-out for reasons, reply composition, and optional voice summary.
              </p>
              <div class="stage-grid">
                <article>
                  <h3>What happens</h3>
                  <p>Merge logic synchronizes result reasons and final response payload into a single API return.</p>
                </article>
                <article>
                  <h3>Systems involved</h3>
                  <div class="badges"><span>LangGraph</span><span>MongoTV RAG</span><span>Grok TTS (optional)</span></div>
                </article>
                <article>
                  <h3>Why it matters</h3>
                  <p>Grounding prevents fabricated titles and keeps recommendations tied to catalog truth.</p>
                </article>
              </div>
            </section>

            <section id="stageE" class="workflow-stage" data-stage="stageE">
              <div class="stage-tag">Stage E</div>
              <h2>Long-term memory and platform efficiency</h2>
              <p class="what-happens">
                Session summaries and long-term memory vectors help personalize future responses while keeping context compact and performant.
              </p>
              <div class="stage-grid">
                <article>
                  <h3>What happens</h3>
                  <p>Chat sessions, message history, and user memory vectors persist with TTL and user-scoped retrieval.</p>
                </article>
                <article>
                  <h3>Systems involved</h3>
                  <div class="badges"><span>MongoDB</span><span>VoyageAI</span><span>TTL Indexes</span></div>
                </article>
                <article>
                  <h3>Why it matters</h3>
                  <p>Only relevant context is surfaced, reducing token overhead and preserving personalization quality.</p>
                </article>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>

  <div class="detail-overlay" data-detail-overlay hidden>
    <button type="button" class="detail-backdrop" aria-label="Close detailed view" data-close-detail></button>
    <aside class="detail-drawer" role="dialog" aria-modal="true" aria-labelledby="detailTitle" tabindex="-1">
      <header class="detail-header">
        <h2 id="detailTitle">Detailed Operational View</h2>
        <button type="button" class="detail-close" aria-label="Close detailed view" data-close-detail>&times;</button>
      </header>
      <div class="detail-body">
        <section class="detail-card">
          <h3>1) How information is stored in the database</h3>
          <div class="detail-grid detail-grid-2">
            <article class="detail-tile">
              <h4>Catalog documents</h4>
              <p>The primary catalog lives in <code>embedded_movies</code> with vector embeddings in <code>plot_embedding_voyage_3_large</code>.</p>
              <p class="note">Vector index: <code>content_vector_index</code>.</p>
            </article>
            <article class="detail-tile">
              <h4>Search indexes</h4>
              <ul>
                <li><code>content_title_autocomplete_index</code> for title lookup</li>
                <li><code>content_people_text_index</code> for cast/directors/writers</li>
              </ul>
            </article>
            <article class="detail-tile">
              <h4>Conversation state</h4>
              <p><code>chat_sessions</code> and <code>chat_messages</code> persist user interactions with TTL lifecycle controls.</p>
            </article>
            <article class="detail-tile">
              <h4>User memories</h4>
              <p><code>user_memories</code> stores preference vectors in <code>embedding</code> and retrieves with user-scoped vector search.</p>
            </article>
          </div>
        </section>

        <section class="detail-card">
          <h3>2) How MongoDB, LangChain, and VoyageAI handle searches</h3>
          <div class="detail-grid detail-grid-3">
            <article class="detail-tile">
              <h4>LangGraph planner</h4>
              <p>Chooses <code>search</code>, <code>clarify</code>, or <code>smalltalk</code> and rewrites query text.</p>
            </article>
            <article class="detail-tile">
              <h4>Voyage embedding</h4>
              <p>Generates query and document embeddings with the correct input type and dimensions.</p>
            </article>
            <article class="detail-tile">
              <h4>Mongo retrieval</h4>
              <p>Runs <code>$vectorSearch</code> and <code>$search</code>, then fuses ranking signals for final results.</p>
            </article>
          </div>
        </section>

        <section class="detail-card">
          <h3>3) MongoDB capabilities for future use cases</h3>
          <div class="detail-grid detail-grid-3">
            <article class="detail-tile"><h4>Geo search</h4><p><code>2dsphere</code> + <code>$geoNear</code> / <code>$geoWithin</code>.</p></article>
            <article class="detail-tile"><h4>Graph traversal</h4><p><code>$graphLookup</code> for relationship exploration.</p></article>
            <article class="detail-tile"><h4>Change streams</h4><p>Real-time rails like trending updates.</p></article>
            <article class="detail-tile"><h4>Time-series analytics</h4><p>Behavior trends and temporal insight.</p></article>
            <article class="detail-tile"><h4>Faceted discovery</h4><p><code>$facet</code> + Atlas compound search filters.</p></article>
            <article class="detail-tile"><h4>Unified platform</h4><p>Operational data, vectors, and search in one system.</p></article>
          </div>
        </section>

        <section class="detail-card">
          <h3>4) How MongoTV understands natural-language context</h3>
          <div class="detail-grid detail-grid-2">
            <article class="detail-tile">
              <h4>Short-term context</h4>
              <p>Rolling summaries and recent turns preserve conversational continuity.</p>
            </article>
            <article class="detail-tile">
              <h4>Long-term context</h4>
              <p>Memory candidates are extracted and vectorized for semantic recall on future turns.</p>
            </article>
            <article class="detail-tile">
              <h4>Intent-aware routing</h4>
              <p>Planner routes ambiguous prompts to clarification before retrieval.</p>
            </article>
            <article class="detail-tile">
              <h4>Grounded synthesis</h4>
              <p>Final answers are built from retrieved catalog content only.</p>
            </article>
          </div>
        </section>

        <section class="detail-card">
          <h3>5) Simplified architecture diagram</h3>
          <p class="diagram-caption">Flow from customer request to generated response:</p>
          <div class="diagram-wrap">
            <pre class="mermaid">
flowchart TD
    User["User message + voiceMode"]
    Auth["optionalAuth middleware"]
    Session["chat_sessions + chat_messages (Mongo)"]
    Memories["user_memories vector search (Mongo + Voyage)"]
    Planner["LangGraph planner node (LLM + Zod schema)"]
    Router{"action?"}
    Smalltalk["smalltalk / clarify reply"]
    Voyage["VoyageAI embedQuery (voyage-3-large, inputType=query)"]
    VectorSearch["$vectorSearch on embedded_movies.plot_embedding_voyage_3_large"]
    Fanout["Parallel fan-out: reasons | compose | voice"]
    Merge["merge node"]
    Response["JSON response: text + results + voiceSummary"]

    User --> Auth --> Session --> Memories --> Planner --> Router
    Router -->|"smalltalk/clarify"| Smalltalk --> Response
    Router -->|search| Voyage --> VectorSearch --> Fanout --> Merge --> Response
    Session -.rolling summary + recent turns.-> Planner
    Memories -.long-term preferences.-> Planner
            </pre>
          </div>
          <div class="legend">
            <h4>Text fallback</h4>
            <ol>
              <li>User message enters the chat endpoint.</li>
              <li>Session history and user memory context are loaded from MongoDB.</li>
              <li>LangGraph planner chooses search vs clarify/smalltalk.</li>
              <li>Voyage creates the query embedding and MongoDB runs retrieval.</li>
              <li>Parallel synthesis merges reasons, response, and voice summary.</li>
              <li>API returns grounded recommendations and response text.</li>
            </ol>
          </div>
        </section>
      </div>
    </aside>
  </div>

  <%- include('partials/chat-overlay') %>

  <script type="module">
    const overlay = document.querySelector('[data-detail-overlay]');
    const drawer = overlay?.querySelector('.detail-drawer');
    const openButtons = document.querySelectorAll('[data-open-detail]');
    const closeButtons = overlay?.querySelectorAll('[data-close-detail]') || [];
    const stageLinks = document.querySelectorAll('[data-stage-link]');
    const stages = document.querySelectorAll('.workflow-stage[data-stage]');
    let lastFocused = null;
    let mermaidInitialized = false;

    function setActiveStage(stageId) {
      stageLinks.forEach((link) => {
        const active = link.dataset.stageLink === stageId;
        link.classList.toggle('active', active);
        link.setAttribute('aria-current', active ? 'true' : 'false');
      });
    }

    if (stages.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActiveStage(entry.target.dataset.stage);
            }
          });
        },
        { rootMargin: '-40% 0px -45% 0px', threshold: 0.01 }
      );
      stages.forEach((stage) => observer.observe(stage));
    }

    async function renderMermaidIfNeeded() {
      if (mermaidInitialized) return;
      mermaidInitialized = true;
      try {
        const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs')).default;
        mermaid.initialize({ startOnLoad: false, theme: 'dark' });
        await mermaid.run({ nodes: overlay.querySelectorAll('.mermaid') });
      } catch (error) {
        console.error('Mermaid failed to load:', error);
      }
    }

    async function openDetail() {
      if (!overlay || !drawer) return;
      lastFocused = document.activeElement;
      overlay.hidden = false;
      document.body.classList.add('no-scroll');
      await renderMermaidIfNeeded();
      drawer.focus();
    }

    function closeDetail() {
      if (!overlay || !drawer) return;
      overlay.hidden = true;
      document.body.classList.remove('no-scroll');
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }

    openButtons.forEach((button) => {
      button.addEventListener('click', openDetail);
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeDetail);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay && !overlay.hidden) {
        closeDetail();
      }
    });
  </script>

